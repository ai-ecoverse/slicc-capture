{
  "name": "@ai-ecoverse/slicc-capture",
  "version": "0.0.0",
  "description": "screencapture for SLICC, and sccapture for SLICC and any host",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-capture.git"
  },
  "engines": {
    "node": ">=24",
    "slicc-kernel": ">=1.153.0"
  },
  "bin": {
    "sccapture": "host/sccapture.mjs"
  },
  "exports": {
    "./page": "./page/index.mjs",
    "./package.json": "./package.json"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-capture",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "slicc": {
    "commands": {
      "screencapture": {
        "script": "bin/screencapture"
      },
      "sccapture": {
        "script": "bin/sccapture"
      }
    },
    "unitSources": [
      "host",
      "page"
    ]
  },
  "files": [
    "bin",
    "host",
    "page"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "lint": "slicc-lint && shellcheck -s sh -e SC1091 install.sh bin/* && for f in install.sh bin/*; do dash -n \"$f\" || exit 1; done",
    "format": "biome check --write .",
    "test": "node --test --test-timeout=120000 test/integration/*.test.mjs",
    "test:windows": "node --test --test-concurrency=1 --test-timeout=600000 test/integration/host.test.mjs test/integration/windows.test.mjs",
    "test:unit": "mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "test:sh": "node scripts/cover.mjs",
    "build": "npm pack --dry-run",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-cdp": "1.41.4",
    "@ai-ecoverse/slicc-kernel": "1.159.4",
    "@ai-ecoverse/slicc-shared-web": "2.12.1",
    "@ai-ecoverse/wasm-bash": "5.3.0-23",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-15",
    "@biomejs/biome": "2.5.15",
    "@semantic-release/exec": "7.1.0",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "slicc-kernel-without-embedder": "npm:@ai-ecoverse/slicc-kernel@1.152.2"
  }
}
