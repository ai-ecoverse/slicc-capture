#!/bin/sh
me=${0##*/}
dev=/dev/embedder
usage() {
  printf 'usage: %s [-acdgimorvwxACPW] [-t format] [-T seconds] [-R x,y,w,h] [-D display] [-J style] [-V seconds] [-G id] [file | -]\n' "$me"
}
row() {
  printf '  %-17s %s\n' "$1" "$2"
}
guide() {
  usage
  printf '\nCaptures a screen, window or tab that the user picks in the browser.\n\n'
  row -A 'with -v, record the audio the user shares in the picker'
  row '-c, --clipboard' 'copy a PNG to the clipboard instead of a file'
  row -C 'ask the browser to include the cursor'
  row '-D display' 'as -m: the user picks the screen'
  row -g 'with -v, record the microphone too'
  row '-G id' 'with -v, record that microphone (a deviceId) too'
  row '-J style' 'window, as -W; video, as -v'
  row -m 'prefer a screen in the picker'
  row '-P, --view' 'show the capture inline in the tool result'
  row '-R x,y,w,h' "crop to that rectangle, in the capture's pixels"
  row '-t format' "png, jpg or webp; with -v webm or mp4; else the file's extension"
  row '-T seconds' 'wait that long after the picker'
  row -v 'record a video until stopped: ^C, a signal, or Stop sharing'
  row '-V seconds' 'record a video for that long'
  row -w 'prefer a window in the picker'
  row -W 'as -w'
  row --version 'print the version'
  row --upgrade 'print the command that upgrades it'
  row '-h, --help' 'print this help'
  printf '\nA file named - is standard output, which must not be a terminal.\n'
  printf '%s\n' "-a, -d, -i, -o, -r, -x: accepted, as macOS's screencapture takes them, and do nothing."
}
say() {
  printf '%s: %s\n' "$me" "$1" >&2
}
bad() {
  say "$1"
  usage >&2
  exit 2
}
refuse() {
  say "$1"
  exit 2
}
die() {
  say "$1"
  exit 1
}
first() {
  [ -n "$problem" ] || problem=$1
}
num() {
  n=$1
  while :; do
    case $n in
      0[0-9]*) n=${n#0} ;;
      *) break ;;
    esac
  done
  printf '%s' "$n"
}
digits() {
  case $1 in
    '' | *[!0-9]*) return 1 ;;
  esac
}
delay() {
  case $1 in
    '' | .* | *. | *.*.* | *[!0-9.]*) return 1 ;;
  esac
}
rect() {
  case $1 in
    *,*,*,*,*) return 1 ;;
    *,*,*,*) ;;
    *) return 1 ;;
  esac
  rx=${1%%,*}
  rest=${1#*,}
  ry=${rest%%,*}
  rest=${rest#*,}
  rw=${rest%%,*}
  rh=${rest#*,}
  digits "$rx" && digits "$ry" && digits "$rw" && digits "$rh" || return 1
  [ "$(num "$rw")" != 0 ] && [ "$(num "$rh")" != 0 ]
}
format() {
  case $1 in
    [pP][nN][gG]) printf image/png ;;
    [jJ][pP][gG] | [jJ][pP][eE][gG]) printf image/jpeg ;;
    [wW][eE][bB][pP]) printf image/webp ;;
  esac
}
movie() {
  case $1 in
    [wW][eE][bB][mM] | [mM][kK][vV]) printf video/webm ;;
    [mM][pP]4 | [mM][oO][vV] | [mM]4[vV]) printf video/mp4 ;;
  esac
}
value() {
  case $1 in
    T)
      delay "$2" || first "-T: invalid delay: $2"
      wait=$2
      ;;
    R)
      rect "$2" || first "-R: invalid rectangle: $2"
      area=$2
      ;;
    D)
      case $2 in
        [1-9]*) digits "$2" || first "-D: invalid display: $2" ;;
        *) first "-D: invalid display: $2" ;;
      esac
      surface=monitor
      ;;
    J)
      case $2 in
        window) surface=window ;;
        video) video=-v ;;
        selection) style=${style:-"-J $2: not supported in SLICC"} ;;
        *) first "-J: invalid style: $2" ;;
      esac
      ;;
    V)
      case $2 in
        *[1-9]*) delay "$2" || first "-V: invalid duration: $2" ;;
        *) first "-V: invalid duration: $2" ;;
      esac
      length=$2
      video=-v
      ;;
    G)
      case $2 in
        '' | *[!A-Za-z0-9+/=_.-]*) first "-G: invalid audio input: $2" ;;
      esac
      mic=$2
      audio=${audio:--G}
      ;;
    t) type=$2 ;;
    *) off=${off:-"-$1"} ;;
  esac
}
flag() {
  case $1 in
    c) clip=1 ;;
    C) cursor=always ;;
    v) video=-v ;;
    P) view=1 ;;
    g)
      mic=${mic:-default}
      audio=${audio:--g}
      ;;
    A)
      system=1
      audio=${audio:--A}
      ;;
    m) surface=monitor ;;
    w | W) surface=window ;;
    a | d | i | o | r | x) ;;
    *) off=${off:-"-$1"} ;;
  esac
}
version() {
  while IFS= read -r line; do
    case $line in
      *'"version": "'*)
        line=${line#*'"version": "'}
        printf '%s\n' "${line%%\"*}"
        return
        ;;
    esac
  done <"${0%/*}/../package.json"
}
relay() {
  while IFS= read -r line; do
    case $line in
      *": $dev: "*) printf '%s\n' "${line#*": $dev: "}" >"$work/message" ;;
      *": printf: write error: "*) printf '%s\n' "${line##*: }" >"$work/header" ;;
      "cat: -: "* | "cat: write error: "*) printf '%s\n' "${line##*: }" >"$work/errno" ;;
      *) printf '%s: %s\n' "$me" "${line#*: }" >&2 ;;
    esac
  done
}
ask() {
  rm -f "$work/message" "$work/header" "$work/errno"
  { { "$@"; } 2>&1 >&5 | relay; } 5>&1 &
  wait "$!"
  header=
  errno=
  message=
  [ ! -f "$work/header" ] || header=$(cat "$work/header")
  [ ! -f "$work/errno" ] || errno=$(cat "$work/errno")
  [ ! -f "$work/message" ] || message=$(cat "$work/message")
  errno=${errno:-$header}
  [ -z "$errno" ]
}
because() {
  printf '%s' "${message:-$errno}"
}
copyfail() {
  case $header in
    "Not supported") die "failed to copy to clipboard: this page does not copy images (no clipboard.write)" ;;
  esac
  die "failed to copy to clipboard: $(because)"
}
stop() {
  [ ! -s "$work/pid" ] || kill -TERM "$(cat "$work/pid")" 2>/dev/null
  wait
  say interrupted
  exit $((128 + $1))
}
halt() {
  [ ! -s "$work/pid" ] || kill -TERM "$(cat "$work/pid")" 2>/dev/null
  wait
  halted=$1
}
refused() {
  case $header in
    "Not supported") die "browser APIs are unavailable in this environment" ;;
  esac
  case $errno in
    "Permission denied") die "user cancelled, permission denied, or the surface is protected" ;;
    "Not supported") die "${message:-screen capture is not supported in this browser}" ;;
  esac
  die "$(because)"
}
absolute() {
  case $1 in
    */*) dir=${1%/*} base=${1##*/} ;;
    *) dir=. base=$1 ;;
  esac
  dir=$(cd -- "${dir:-/}" && pwd)
  printf '%s/%s' "${dir%/}" "$base"
}
cleanup() {
  rm -rf "$work"
}
argc=$#
clip=
view=
video=
length=
mic=
system=
audio=
halted=
cursor=never
surface=
wait=
area=
type=
style=
off=
problem=
wrong=
special=
help=
ended=
files=0
file=
while [ $# -gt 0 ]; do
  arg=$1
  shift
  if [ -n "$ended" ]; then
    files=$((files + 1))
    file=${file:-$arg}
    continue
  fi
  case $arg in
    --) ended=1 ;;
    --help) help=1 ;;
    --version | --upgrade) special=${special:-$arg} ;;
    --clipboard) clip=1 ;;
    --view) view=1 ;;
    --*) wrong=${wrong:-"unknown option: $arg"} ;;
    -?*)
      rest=${arg#-}
      while [ -n "$rest" ]; do
        letter=${rest%"${rest#?}"}
        rest=${rest#?}
        case $letter in
          h) help=1 ;;
          [BDGJlRtTV])
            if [ -n "$rest" ]; then
              value "$letter" "$rest"
            elif [ $# -gt 0 ]; then
              value "$letter" "$1"
              shift
            else
              wrong=${wrong:-"-$letter: option requires a value"}
            fi
            rest=
            ;;
          [aAbcCdgikmMoprPsSuUvwWx]) flag "$letter" ;;
          *)
            wrong=${wrong:-"unknown option: -$letter"}
            rest=
            ;;
        esac
      done
      ;;
    *)
      files=$((files + 1))
      file=${file:-$arg}
      ;;
  esac
done
if [ -n "$help" ]; then
  guide
  exit 0
fi
[ -z "$wrong" ] || bad "$wrong"
if [ -n "$special" ]; then
  [ "$argc" -eq 1 ] || bad "$special: takes no other arguments"
  if [ "$special" = --upgrade ]; then
    printf 'pnpm add -g @ai-ecoverse/slicc-capture@latest\n'
  else
    version
  fi
  exit 0
fi
[ -z "$off" ] || refuse "$off: not supported in SLICC"
[ -z "$problem" ] || refuse "$problem"
[ -z "$style" ] || refuse "$style"
[ -z "$audio" ] || [ -n "$video" ] || refuse "$audio: needs -v"
if [ -n "$video" ]; then
  [ -z "$clip" ] || refuse "-c: not with -v"
  [ -z "$view" ] || refuse "-P: not with -v in SLICC"
  [ -z "$area" ] || refuse "-R: not with -v in SLICC"
fi
if [ -n "$clip" ]; then
  file=
  files=0
fi
[ "$files" -le 1 ] || refuse "more than one file: not supported in SLICC"
[ -n "$file" ] || [ -n "$clip" ] || [ -n "$view" ] || bad "output file required (or use -c for clipboard)"
out=
if [ "$file" = - ]; then
  [ -z "$view" ] || refuse "-P: not with -"
  [ ! -t 1 ] || refuse "refusing to write to a terminal: redirect standard output or name a file"
  out=1
fi
kind=format
[ -z "$video" ] || kind=movie
if [ -n "$clip" ]; then
  mime=image/png
elif [ -n "$type" ]; then
  mime=$($kind "$type")
  [ -n "$mime" ] || refuse "-t $type: not supported in SLICC"
else
  mime=$($kind "${file##*.}")
  case $file in
    *.*) ;;
    *) mime= ;;
  esac
  [ -n "$mime" ] || mime=image/png
  [ -z "$video" ] || [ "$mime" != image/png ] || mime=video/webm
fi
[ -c "$dev" ] || die "$dev not available (needs slicc-kernel >= 1.153.0)"
request="{\"kind\":\"capture.screen\",\"type\":\"$mime\""
case $mime in
  image/jpeg | image/webp) request="$request,\"quality\":0.92" ;;
esac
request="$request,\"cursor\":\"$cursor\""
[ -z "$surface" ] || request="$request,\"surface\":\"$surface\""
[ -z "$wait" ] || request="$request,\"delay\":$(num "${wait%%.*}")${wait#"${wait%%.*}"}"
[ -z "$area" ] || request="$request,\"rect\":{\"x\":$(num "$rx"),\"y\":$(num "$ry"),\"width\":$(num "$rw"),\"height\":$(num "$rh")}"
[ -z "$length" ] || request="$request,\"duration\":$(num "${length%%.*}")${length#"${length%%.*}"}"
[ -z "$system" ] || request="$request,\"system\":true"
case $mic in
  '') ;;
  default) request="$request,\"microphone\":true" ;;
  *) request="$request,\"microphone\":\"$mic\"" ;;
esac
request="$request}"
work=$(mktemp -d 2>/dev/null) || die "failed to create a temporary directory in ${TMPDIR:-/tmp}"
trap cleanup EXIT
if [ -n "$video" ]; then
  trap 'halt 1' HUP
  trap 'halt 2' INT
  trap 'halt 15' TERM
else
  trap 'stop 1' HUP
  trap 'stop 2' INT
  trap 'stop 15' TERM
fi
if [ -n "$clip" ]; then
  exec 4<>"$dev"
  ask sh -c "printf '%s\\n' \"\$1\" >&4" sh '{"kind":"clipboard.write","type":"image/png"}' || copyfail
fi
exec 3<>"$dev"
ask sh -c "printf '%s\\n' \"\$1\" >&3 || exit 1; cat <&3 & echo \$! >\"\$2\"; wait \$!" sh "$request" "$work/pid" >"$work/image" || [ -n "$halted" ] || refused
[ -z "$halted" ] || [ -s "$work/image" ] || stop "$halted"
exec 3<&-
size=$(wc -c <"$work/image")
what=image
[ -z "$video" ] || what=video
[ "$size" -gt 0 ] || die "the page sent no $what"
kb=$(((size + 512) / 1024))
if [ -n "$clip" ]; then
  ask cat "$work/image" >&4 || copyfail
  ask sh -c 'cat <&4' >/dev/null || copyfail
  exec 4<&-
  printf 'captured %s KB to clipboard\n' "$kb"
fi
if [ -n "$out" ]; then
  cat "$work/image" || die "failed to write to standard output"
  exit 0
fi
if [ -z "$file" ]; then
  [ -n "$view" ] || exit 0
  file=$(mktemp "${TMPDIR:-/tmp}/screencapture-XXXXXX.${mime#image/}" 2>/dev/null) || die "failed to create a temporary file in ${TMPDIR:-/tmp}"
fi
err=$(tee -- "$file" <"$work/image" 2>&1 >/dev/null) || die "failed to write file: ${err#tee: }"
if [ -n "$view" ]; then
  printf '<img:%s>\n' "$(absolute "$file")"
elif [ -z "$clip" ]; then
  printf 'captured %s KB to %s\n' "$kb" "$file"
fi
